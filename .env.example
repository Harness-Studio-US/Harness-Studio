# Firebase web app configuration
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
# Copy these values into .env.local for local development.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: answer Harness Copilot and Harness Code with a real model running on
# your own machine instead of the scripted demo replies. Leave VITE_AI_MODEL
# empty to keep the demo. The dev server forwards /api/ollama to
# http://127.0.0.1:11434 (see vite.config.ts), so the model must exist in Ollama:
#   bash models/setup.sh          # builds the "harness-code" model, Apache-2.0 base
#   VITE_AI_MODEL=harness-code
# Pull a base directly instead if you prefer:
#   ollama pull qwen3:4b
#   VITE_AI_MODEL=qwen3:4b
VITE_AI_MODEL=

# Set to 1 for hybrid-reasoning models (Qwen3) served under a custom name, so
# replies skip the thinking block and answer straight away.
VITE_AI_NO_THINK=

# Where Ollama is. Defaults to this machine. Point it at another computer to use
# a model running there (it must listen on the network: OLLAMA_HOST=0.0.0.0).
#   VITE_AI_UPSTREAM=http://192.168.1.42:11434
VITE_AI_UPSTREAM=

# For the hosted build (GitHub Pages) there is no dev server to proxy, so the
# page calls the model directly. Point this at an HTTPS tunnel in front of Ollama
# and set OLLAMA_ORIGINS on that machine to the site's origin.
#   VITE_AI_ENDPOINT=https://model.example.com/v1
# The GitHub Pages workflow reads this from the repository variable
# VITE_AI_ENDPOINT (Settings -> Secrets and variables -> Actions -> Variables),
# so a new tunnel needs no code change. Leave that variable unset and the
# deployed site keeps the scripted demo.
VITE_AI_ENDPOINT=
